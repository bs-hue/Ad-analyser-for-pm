# ==============================================================================
# PERFORMANCE MARKETING INTELLIGENCE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Place your real credentials here. This file is kept local and never published.
# After updating any key, restart your dev server (Ctrl+C then `npm run dev`).

# ------------------------------------------------------------------------------
# 1. AI MULTIMODAL & VIDEO ANALYSIS (REQUIRED FOR VIDEO / HOOK ANALYSIS)
# ------------------------------------------------------------------------------
# Gemini is recommended for video creative intelligence because it natively
# accepts video files, transcribes speech, and analyzes on-screen visual hooks.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. OPENROUTER (RECOMMENDED FOR REASONING, DIAGNOSTICS & AD COPY GENERATION)
# ------------------------------------------------------------------------------
# Use OpenRouter for Claude 3.5 Sonnet, GPT-4o, DeepSeek, Llama, etc.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model (can be anthropic/claude-3.5-sonnet, openai/gpt-4o-mini, google/gemini-2.0-flash-001, etc.)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 3. ANTHROPIC CLAUDE DIRECT (OPTIONAL)
# ------------------------------------------------------------------------------
# Direct Anthropic API key (optional alternative to OpenRouter).
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE API (OPTIONAL)
# ------------------------------------------------------------------------------
# NOTE: If your Google Drive links are set to "Anyone with the link can view",
# NO KEY IS NEEDED! The app fetches and previews public links automatically.
# Only needed if you want to access restricted/private Google Drive files.
GOOGLE_DRIVE_API_KEY=

# ------------------------------------------------------------------------------
# 4. META ADS MARKETING API (OPTIONAL - FOR DIRECT ADS MANAGER 1-CLICK SYNC)
# ------------------------------------------------------------------------------
# Only needed if you want to bypass CSV/Sheets and sync directly from Meta.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 5. SQL DATABASE (ZERO-CREDENTIAL LOCAL EMBEDDED SQL BY DEFAULT)
# ------------------------------------------------------------------------------
# A local SQL database is automatically created in `./data/mysql.db`.
# NO EXTERNAL DATABASE, NO CREDENTIALS, AND NO PASSWORDS REQUIRED!
#
# GUARANTEE: Videos and heavy media are NEVER stored in the database.
# Only spend/sales numbers, copy text, calculations, and Google Drive links.
#
# Optional custom database file path:
# LOCAL_DB_FILE=mysql.db
